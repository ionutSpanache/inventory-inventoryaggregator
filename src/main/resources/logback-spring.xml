<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <logger name="io.micrometer.datadog" level="WARN"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>

            <fieldNames>
                <version>[ignore]</version>
            </fieldNames>


            <includeMdc>true</includeMdc>

            <customFields>{"@vertical": "${DRP_CF_VERTICAL}", "@type": "service", "@service-name": "${DRP_CF_SERVICE}",
                "@hostname": "${HOSTNAME}", "@retention" : "technical", "marc_id": "${DRP_EV_DD_MARC_ID}", "vertical":
                "${DRP_CF_VERTICAL}", "solution": "${DRP_EV_DD_SOLUTION}", "solution_id": "${DRP_EV_DD_SOLUTION_ID}" }
            </customFields>
            <includeContext>false</includeContext>

            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>50</maxDepthPerThrowable>
                <maxLength>10240</maxLength>
                <shortenedClassNameLength>30</shortenedClassNameLength>
                <exclude>sun\.reflect\..*\.invoke.*</exclude>
                <exclude>net\.sf\.cglib\.proxy\.MethodProxy\.invoke</exclude>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- By default, the level of the root level is set to DEBUG -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <!-- <appender-ref ref="FILE" /> -->
    </root>
</configuration>
